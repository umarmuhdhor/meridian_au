# ─────────────────────────────────────────────────────────────────────────────
# Meridian — homeserver lokal (Windows, native Node + pm2).
#
# SALIN file ini ke root repo sebagai `.env`:
#     copy deploy\homeserver\env.daemon.sample .env
#
# Lalu isi 3 rahasia (DASHBOARD_TOKEN, MERIDIAN_SESSION_SECRET,
# MERIDIAN_DASHBOARD_PIN_HASH) dengan:
#     node scripts/setup-local-secrets.mjs
#
# Dibaca daemon lewat src/entrypoints/load-env.ts (dotenv). `.env` gitignored.
#
# MODE SAAT INI: DRY RUN — tanpa wallet, tanpa transaksi on-chain.
# ─────────────────────────────────────────────────────────────────────────────

# ── Gate keamanan. INI yang menentukan real vs fake — BUKAN DRY_RUN. ─────────
MERIDIAN_CHAIN=dryrun
MERIDIAN_WRITE_UNSAFE=false
MERIDIAN_DEMO=true

# ── Runtime ──────────────────────────────────────────────────────────────────
MERIDIAN_AUTONOMOUS=true
# HARUS root repo, bukan subfolder. Daemon membaca user-config.json dari cwd
# (hardcoded, src/entrypoints/daemon.ts), sedangkan dashboard membaca SEMUA file
# — termasuk user-config.json — dari satu folder MERIDIAN_ROOT. Kalau keduanya
# beda, halaman Config tampil KOSONG tanpa error. Di Docker ini diakali dengan
# bind-mount; di Windows satukan saja. File state di root sudah di-gitignore.
MERIDIAN_STATE_DIR=D:/Abang/Agent/meridian_au

# ── Control bridge (127.0.0.1 only; dipakai dashboard Next.js) ───────────────
DASHBOARD_ENABLED=true
DASHBOARD_PORT=8787

# ── Telegram: mati. Isi TELEGRAM_BOT_TOKEN + TELEGRAM_CHAT_ID kalau mau kartu
#    deploy/close terkirim. Inbound tetap false (Meridian hanya posting keluar).
MERIDIAN_TELEGRAM_INBOUND=false

# ─────────────────────────────────────────────────────────────────────────────
# LIVE TRADING — jangan diaktifkan sampai hosting terverifikasi.
# Ubah 3 gate di atas jadi:
#     MERIDIAN_CHAIN=meteora
#     MERIDIAN_WRITE_UNSAFE=true
#     MERIDIAN_DEMO=false
# lalu isi:
# WALLET_PRIVATE_KEY=    # base58 (~87-88 char) ATAU JSON byte-array. BUKAN base64.
# RPC_URL=               # Solana mainnet RPC (Helius dsb.)
# OPENROUTER_API_KEY=
# ─────────────────────────────────────────────────────────────────────────────

# Diisi otomatis oleh scripts/setup-local-secrets.mjs — jangan diketik manual:
# DASHBOARD_TOKEN=
# MERIDIAN_SESSION_SECRET=
# MERIDIAN_DASHBOARD_PIN_HASH=
